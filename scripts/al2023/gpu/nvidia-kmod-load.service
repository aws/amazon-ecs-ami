[Unit]
Description=NVIDIA kernel module loader
# dkms.service runs dkms autoinstall at boot and takes no lock
After=dkms.service
Before=nvidia-fabricmanager.service nvidia-persistenced.service ecs.service
Before=nvidia-gridd.service nvidia-mps.service set-nvidia-clocks.service

[Service]
Type=oneshot
ExecStart=/etc/ecs/nvidia-kmod-load.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
